  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#828BAE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#B07CD6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#6F9EF5"
      }
    },
    {
      "name": "Strings & Literals",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#A9D67A"
      }
    },
    {
      "name": "Classes, Types & Interfaces",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#E8B463"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#D5D6E1"
      }
    },
    {
      "name": "Object Keys, Properties & Attributes",
      "scope": [
        "meta.object-literal.key",
        "support.variable.property",
        "variable.other.property",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#74C9E8"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#D47D8A"
      }
    },
    {
      "name": "Constants, Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#C89A6A"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace",
        "meta.delimiter",
        "punctuation.definition.tag",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#A9ADC1"
      }
    },
    {
      "name": "Template Interpolation & Regex",
      "scope": [
        "punctuation.definition.template-expression",
        "meta.template.expression",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#74C9E8"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#6F9EF5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#74C9E8",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#C89A6A"
      }
    },
    {
      "name": "Markdown Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#828BAE",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#E8B463",
    "interface": "#E8B463",
    "type": "#E8B463",
    "enum": "#C89A6A",
    "enumMember": "#C89A6A",
    "parameter": "#74C9E8",
    "variable": "#D5D6E1",
    "property": "#74C9E8",
    "function": "#6F9EF5",
    "method": "#6F9EF5",
    "keyword": {
      "foreground": "#B07CD6",
      "fontStyle": "italic"
    },
    "string": "#A9D67A",
    "number": "#C89A6A",
    "boolean": "#C89A6A",
    "comment": {
      "foreground": "#828BAE",
      "fontStyle": "italic"
    },
    "operator": "#A9ADC1",
    "decorator": "#E8B463"
  }
}
